VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_GOOGLE_LOGIN_ENABLED=false

# Server only: configure in Vercel; never prefix these with VITE_.
# Keep the existing admin notification configuration.
# EVENT_NOTIFICATION_FROM=Makers <verified-sender@your-domain.example>
# CRON_SECRET=
# ZOOM_WEBHOOK_SECRET=
# GOOGLE_MEET_CLIENT_ID=
# GOOGLE_MEET_CLIENT_SECRET=
# GOOGLE_MEET_REFRESH_TOKEN=

# 1.6 — servidor: mantener desconectado hasta vincular un registro autorizado de Makers.
MAKERS_REGISTRY_ENABLED=false
# Nodi se configura en launch_settings.nodi_url cuando RRHH entregue el enlace.
# No se usan ni se requieren claves Stripe en esta versión.

# Servidor (api/ en Vercel). Solo nombres: pon los valores en Vercel → Settings → Environment Variables.
# APP_ORIGIN=https://tu-dominio.vercel.app
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=        (secreta; nunca con prefijo VITE_)
# RESEND_API_KEY=                   (avisos por correo)
# ADMIN_NOTIFICATION_FROM=Makers <verified-sender@your-domain.example>
# OPENAI_API_KEY=                   (asistente opcional de IA)
# OPENAI_MODEL=
